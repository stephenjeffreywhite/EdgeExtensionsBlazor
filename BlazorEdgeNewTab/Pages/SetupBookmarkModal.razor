@if (ShowSetUpModal)
{
    <div class="modal fade @(ShowSetUpModal ? "show" : "")" id="SetupModal" tabindex="-1" aria-labelledby="StartUpModalTitle" aria-hidden="true" style="display:@(ShowSetUpModal ? "block" : "none")">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content M365PopUp">
                <div class="modal-header">
                    <h5 class="modal-title text-secondary" id="StartUpModalTitle">Edit Quick Link</h5>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="QuickLinkBookMarkFolderName" class="form-label">Select A Bookmarks Folder To Use For Your Quick Links</label>
                        <div class="dropdown">
                            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Select A Bookmark Folder...
                            </button>
                            <ul class="dropdown-menu" data-bs-theme="dark">
                                @foreach (var folder in BookmarkFolders)
                                {
                                    <li><a class="dropdown-item" @onclick="() => SetNewQuickLinkBookMarkFolderName(folder)">@folder</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="QuickLinkBookMarkFolderName" class="form-label">Selected Quicklink Folder</label>
                        <InputText Value="@NewQuickLinkBookMarkFolderName" ValueExpression="@(() => NewQuickLinkBookMarkFolderName)" ValueChanged="@QuickLinkFolderChanged" class="form-control"
                                   aria-describedby="QuickLinkBookMarkFolderNameHelp" data-bs-theme="dark" id="QuickLinkBookMarkFolderName"></InputText>
                        <div data-bs-theme="dark" id="QuickLinkBookMarkFolderNameHelp" class="form-text">Enter the name of the folder you want to use for your quick links. Subfolders are ignored. Enter a new bookmark folder name if you want to create a new folder.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="@(() => SetUpQuickLinksFolder.InvokeAsync())" data-bs-dismiss="modal">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {

    [Parameter]
    public List<string> BookmarkFolders { get; set; }
    [Parameter]
    public bool ShowSetUpModal { get; set; }
    [Parameter]
    public string NewQuickLinkBookMarkFolderName { get; set; }
    [Parameter]
    public EventCallback<string> NewQuickLinkBookMarkFolderNameChanged { get; set; }
    [Parameter]
    public EventCallback SetUpQuickLinksFolder { get; set; }

    private async Task SetNewQuickLinkBookMarkFolderName(string folder)
    {
        NewQuickLinkBookMarkFolderName = folder;
        await NewQuickLinkBookMarkFolderNameChanged.InvokeAsync(NewQuickLinkBookMarkFolderName);
        await InvokeAsync(StateHasChanged);
    }

    private async Task QuickLinkFolderChanged(string value)
    {
        await NewQuickLinkBookMarkFolderNameChanged.InvokeAsync(value);
    }
}
