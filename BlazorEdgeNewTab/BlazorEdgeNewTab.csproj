<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>2026.1021.1.0</AssemblyVersion>
		<FileVersion>2026.1021.1.0</FileVersion>
    <NoWarn>$(NoWarn);NU1504;NU1605</NoWarn>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Blazor.BrowserExtension" Version="5.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="wwwroot\**\*" CopyToOutputDirectory="Always" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Remove="wwwroot\css\bootstrap.min.css.map" />
		<Content Remove="wwwroot\jsInteropScripts.js" />
		<Content Remove="wwwroot\js\bootstrap.bundle.min.js.map" />
	</ItemGroup>

</Project>
