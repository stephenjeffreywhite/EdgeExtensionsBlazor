<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<AssemblyVersion>2024.0407.2.0</AssemblyVersion>
		<FileVersion>2024.0407.2.0</FileVersion>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<LangVersion>10</LangVersion>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Blazor.BrowserExtension" Version="3.1.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.6" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.6" PrivateAssets="all" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="wwwroot\**\*" CopyToOutputDirectory="Always" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Remove="wwwroot\jsInteropScripts.js" />
	</ItemGroup>
	
	<ItemGroup>
		<Folder Include="wwwroot\css\" />
	</ItemGroup>

</Project>
